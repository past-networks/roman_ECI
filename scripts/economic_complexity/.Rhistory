intersecting_countries <- world_sf$iso3[apply(intersecting_indices, 1, any)]
saveRDS(intersecting_indices, "../../data/economic_complexity/intersecting_indices.rds")
saveRDS(intersecting_countries, "../../data/economic_complexity/intersecting_countries.rds")
intersecting_indices <- st_intersects(world_sf, provinces, sparse = FALSE)
intersecting_countries <- world_sf$iso3[apply(intersecting_indices, 1, any)]
saveRDS(intersecting_indices, "../../data/economic_complexity/intersecting_indices.rds")
saveRDS(intersecting_countries, "../../data/economic_complexity/intersecting_countries.rds")
intersecting_countries <- readRDS("../../data/economic_complexity/intersecting_countries.rds")
intersecting_indices <- readRDS("../../data/economic_complexity/intersecting_indices.rds")
